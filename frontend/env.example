# FastAPI backend (Railway)
VITE_API_BASE_URL=https://api.phoenix-thcs.online

# Stadia Maps. localhost works with no key; deployed domains use domain auth
# (add the domain in the Stadia dashboard). Only set a key if you use key auth.
VITE_STADIA_STYLE=alidade_smooth
VITE_STADIA_API_KEY=

# Set to true once GET /api/v1.2/clusters/ (list endpoint) exists in router.py
VITE_HYDRATE_ON_LOAD=false
